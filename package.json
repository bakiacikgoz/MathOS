{
  "name": "mathos",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Agentic mathematical research environment",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "bin": {
    "mathos": "./apps/tui/src/cli.ts"
  },
  "scripts": {
    "mathos": "bun run apps/tui/src/cli.ts",
    "test": "bun test",
    "typecheck": "$npm_execpath x tsc --noEmit -p tsconfig.json",
    "build": "$npm_execpath scripts/build.ts",
    "release-check": "$npm_execpath scripts/release-check.ts",
    "package-smoke": "$npm_execpath dist/cli.js --help",
    "pilot-validation": "$npm_execpath scripts/pilot-validation.ts",
    "feature-program-preflight": "$npm_execpath scripts/feature-program-preflight.ts",
    "typecheck:all": "$npm_execpath x tsc --noEmit -p tsconfig.json",
    "build:atlas": "$npm_execpath scripts/build-atlas.ts",
    "build:vscode": "$npm_execpath scripts/build-vscode.ts",
    "vscode:build": "$npm_execpath scripts/build-vscode.ts",
    "vscode:package": "$npm_execpath scripts/distribution/package-vsix.ts",
    "vscode:verify": "$npm_execpath scripts/distribution/verify-vsix.ts",
    "release:build": "$npm_execpath scripts/distribution/build-release.ts",
    "release:verify": "$npm_execpath scripts/distribution/verify-release.ts",
    "test:v1": "$npm_execpath test tests/feature-program-preflight.test.ts tests/v1-doc-contract.test.ts tests/workspace-boundaries.test.ts",
    "qualification:v1": "$npm_execpath scripts/run-v1-qualification.ts --json"
    ,"software-completion-v2": "$npm_execpath scripts/run-software-completion-v2.ts"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "bun-types": "^1.4.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@opentui/core": "^0.5.7",
    "@opentui/keymap": "^0.5.7",
    "@opentui/solid": "^0.5.7",
    "solid-js": "1.9.12"
  }
}
