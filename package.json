{
  "name": "mathos",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Agentic mathematical research environment",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "bin": {
    "mathos": "./apps/tui/src/cli.ts"
  },
  "scripts": {
    "mathos": "bun run apps/tui/src/cli.ts",
    "test": "bun test",
    "typecheck": "$npm_execpath x tsc --noEmit -p tsconfig.json",
    "build": "$npm_execpath scripts/build.ts",
    "release-check": "bun scripts/release-check.ts",
    "package-smoke": "$npm_execpath dist/cli.js --help"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "devDependencies": {
    "bun-types": "^1.4.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@opentui/core": "^0.5.7",
    "@opentui/keymap": "^0.5.7",
    "@opentui/solid": "^0.5.7",
    "solid-js": "1.9.12"
  }
}
